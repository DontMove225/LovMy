# ══════════════════════════════════════════════════════════════════════════
#  LovMy — PROD — variables docker compose  (--env-file)
#  Emplacement final sur le VPS : /opt/lovmy/prod/compose.env
# ══════════════════════════════════════════════════════════════════════════
COMPOSE_PROJECT_NAME=lovmy-prod
ENV=prod
ENV_DIR=/opt/lovmy/prod
PUBLIC_HOST=lovmy.fr

# ── Reverse-proxy (Traefik géré par Dokploy) ──────────────────────────────
TRAEFIK_NETWORK=traefik-proxy
CERT_RESOLVER=letsencrypt

# ── Images (taguées par env) ──────────────────────────────────────────────
BACKEND_IMAGE=lovmy-backend:prod
FRONTEND_IMAGE=lovmy-frontend:prod
LANDING_IMAGE=lovmy-landing:prod

# ── Base de données (DOIT correspondre à backend.env) ─────────────────────
DB_DATABASE=lovmy
DB_USERNAME=lovmy
DB_PASSWORD=__CHANGE_ME_DB__
DB_ROOT_PASSWORD=__CHANGE_ME_ROOT__

# ── Limites ressources (VPS KVM2 sous pression : garder bas) ───────────────
BACKEND_MEM=384m
FRONTEND_MEM=384m
DB_MEM=320m
LANDING_MEM=32m
