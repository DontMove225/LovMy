# ══════════════════════════════════════════════════════════════════════════
#  LovMy — STAGING — variables docker compose  (--env-file)
#  Emplacement final sur le VPS : /opt/lovmy/staging/compose.env
# ══════════════════════════════════════════════════════════════════════════
COMPOSE_PROJECT_NAME=lovmy-staging
ENV=staging
ENV_DIR=/opt/lovmy/staging
PUBLIC_HOST=lovmy.dontmove.app

# ── Reverse-proxy (Traefik géré par Dokploy) ──────────────────────────────
TRAEFIK_NETWORK=traefik-proxy
CERT_RESOLVER=letsencrypt

# ── Images (taguées par env) ──────────────────────────────────────────────
BACKEND_IMAGE=lovmy-backend:staging
FRONTEND_IMAGE=lovmy-frontend:staging
LANDING_IMAGE=lovmy-landing:staging

# ── Base de données (DOIT correspondre à backend.env) ─────────────────────
DB_DATABASE=lovmy
DB_USERNAME=lovmy
DB_PASSWORD=__CHANGE_ME_DB__
DB_ROOT_PASSWORD=__CHANGE_ME_ROOT__

# ── Limites ressources (VPS KVM2 sous pression : garder bas) ───────────────
BACKEND_MEM=288m
FRONTEND_MEM=384m
DB_MEM=256m
LANDING_MEM=32m
