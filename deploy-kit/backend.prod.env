# ══════════════════════════════════════════════════════════════════════════
#  LovMy BACKEND (Laravel 12) — PROD
#  Monté dans le conteneur en /var/www/html/.env
#  Emplacement VPS : /opt/lovmy/staging/backend.env
# ══════════════════════════════════════════════════════════════════════════
APP_NAME=LovMy
APP_ENV=production
APP_KEY=__CHANGE_ME_APPKEY__
APP_DEBUG=false
APP_URL=https://lovmy.fr

LOG_CHANNEL=stack
LOG_LEVEL=warning

# ── Base de données : DB_HOST=db (nom du service, réseau interne) ──────────
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=lovmy
DB_USERNAME=lovmy
DB_PASSWORD=__CHANGE_ME_DB__

# ── Cache / Queue / Session — SANS ext-redis => file/sync (voir guide §7) ──
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# ── Sanctum : same-origin, donc l'host public suffit ──────────────────────
SANCTUM_STATEFUL_DOMAINS=lovmy.fr

# ══ Intégrations (à compléter) ════════════════════════════════════════════
MAIL_MAILER=smtp
MAIL_HOST=smtp.lovmy.fr
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@lovmy.fr"
MAIL_FROM_NAME="LovMy"

ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS=storage/firebase-credentials.json
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
GOOGLE_MAPS_KEY=
STRIPE_KEY=
STRIPE_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=live
